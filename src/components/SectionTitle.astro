---
interface Props {
  eyebrow?: string;
  title: string;
  align?: 'center' | 'left';
}
const { eyebrow, title, align = 'center' } = Astro.props;
---

<div class:list={['reveal mb-12 sm:mb-16', align === 'center' ? 'text-center' : 'text-left']}>
  {eyebrow && <p class="mb-3 text-xs font-semibold uppercase tracking-[0.3em] text-sage-600 sm:text-sm">{eyebrow}</p>}
  <h2 class="font-display text-3xl text-charcoal sm:text-4xl md:text-5xl">{title}</h2>
  <div class:list={['mt-5 flex items-center gap-3', align === 'center' && 'justify-center']}>
    <span class="h-px w-10 bg-gold-500"></span>
    <span class="text-gold-500" aria-hidden="true">✦</span>
    <span class="h-px w-10 bg-gold-500"></span>
  </div>
</div>
