---
import SectionTitle from './SectionTitle.astro';
import { events, dressCode, notices } from '../data/info';

const rotaUrl = (address: string) =>
  `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(address)}`;
---

<section id="informacoes" class="bg-ivory py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <SectionTitle eyebrow="Tudo o que você precisa saber" title="Informações" />

    <!-- Cerimônia e Recepção -->
    <div class="grid gap-6 md:grid-cols-2">
      {
        events.map((ev) => (
          <article class="reveal rounded-2xl border border-sage-200/70 bg-white p-8 text-center shadow-soft transition hover:-translate-y-1">
            <div class="text-4xl" aria-hidden="true">{ev.icon}</div>
            <h3 class="mt-3 font-display text-2xl text-charcoal">{ev.name}</h3>
            <p class="mt-2 font-bold text-sage-600">
              {ev.dateLabel} · {ev.time}
            </p>
            <p class="mt-3 font-semibold">{ev.place}</p>
            <p class="mt-1 text-sm text-charcoal/70">{ev.address}</p>
            <p class="mt-4 border-t border-sage-100 pt-4 text-sm italic text-charcoal/70">{ev.note}</p>
            <a
              href={rotaUrl(ev.address)}
              target="_blank"
              rel="noopener"
              class="mt-5 inline-block rounded-full border border-sage-500 px-6 py-2.5 text-sm font-semibold text-sage-700 transition hover:bg-sage-500 hover:text-ivory"
            >
              📍 Traçar rota
            </a>
          </article>
        ))
      }
    </div>

    <!-- Dress code + Avisos -->
    <div class="mt-6 grid gap-6 md:grid-cols-2">
      <article class="reveal rounded-2xl bg-sage-100 p-8">
        <h3 class="font-display text-2xl text-sage-800">👔 {dressCode.title}</h3>
        <p class="mt-3 text-sm leading-relaxed text-charcoal/80">{dressCode.description}</p>
        <div class="mt-6 grid gap-6 sm:grid-cols-2">
          <div>
            <p class="text-xs font-bold uppercase tracking-widest text-sage-600">Sugestões</p>
            <ul class="mt-3 space-y-2 text-sm text-charcoal/80">
              {dressCode.suggestions.map((s) => <li class="flex gap-2"><span class="text-sage-600">✓</span>{s}</li>)}
            </ul>
          </div>
          <div>
            <p class="text-xs font-bold uppercase tracking-widest text-rose-400">Evite</p>
            <ul class="mt-3 space-y-2 text-sm text-charcoal/80">
              {dressCode.avoid.map((s) => <li class="flex gap-2"><span class="text-rose-400">✕</span>{s}</li>)}
            </ul>
          </div>
        </div>
      </article>

      <article class="reveal rounded-2xl border border-rose-400/40 bg-rose-400/10 p-8">
        <h3 class="font-display text-2xl text-charcoal">📌 Avisos importantes</h3>
        <ul class="mt-4 space-y-4 text-sm leading-relaxed text-charcoal/80">
          {
            notices.map((n) => (
              <li class="flex gap-3">
                <span class="shrink-0 text-lg" aria-hidden="true">{n.icon}</span>
                <span>{n.text}</span>
              </li>
            ))
          }
        </ul>
      </article>
    </div>
  </div>
</section>
