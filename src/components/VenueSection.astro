---
import SectionTitle from './SectionTitle.astro';
import { venue } from '../data/venue';

const mapEmbedUrl = `https://maps.google.com/maps?q=${encodeURIComponent(venue.mapQuery)}&z=15&output=embed`;
const routeUrl = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(venue.mapQuery)}`;
---

<section id="local" class="bg-sand py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <SectionTitle eyebrow="Onde vai acontecer" title="Local" />

    <div class="grid items-stretch gap-6 lg:grid-cols-2">
      <!-- Mapa -->
      <div class="reveal min-h-80 overflow-hidden rounded-2xl border border-sage-200/70 shadow-soft">
        <iframe
          class="h-full min-h-80 w-full"
          src={mapEmbedUrl}
          loading="lazy"
          title={`Mapa — ${venue.name}`}
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>

      <!-- Endereço + dicas + hotéis -->
      <div class="flex flex-col gap-6">
        <article class="reveal rounded-2xl border border-sage-200/70 bg-white p-8 shadow-soft min-h-80 grid justify-center">
          <h3 class="font-display text-2xl text-charcoal">{venue.name}</h3>
          <p class="mt-3 text-sm leading-relaxed text-charcoal/80">📍 {venue.address}</p>
          <div class="flex items-center justify-center">
            <a
              href={routeUrl}
              target="_blank"
              rel="noopener"
              class="w-full text-center mt-5 inline-block rounded-full bg-sage-800 px-6 py-2.5 text-sm font-semibold text-ivory transition hover:bg-sage-600"
            >
              🚗 Como chegar
            </a>
          </div>
        </article>
      </div>
    </div>
  </div>
</section>
