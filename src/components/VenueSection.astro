---
import SectionTitle from './SectionTitle.astro';
import { venue } from '../data/venue';

const mapEmbedUrl = `https://maps.google.com/maps?q=${encodeURIComponent(venue.address)}&z=15&output=embed`;
const routeUrl = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(venue.address)}`;
---

<section id="local" class="bg-sand py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <SectionTitle eyebrow="Onde vai acontecer" title="Local" />

    <div class="grid items-stretch gap-6 lg:grid-cols-2">
      <!-- Mapa -->
      <div class="reveal min-h-80 overflow-hidden rounded-2xl border border-sage-200/70 shadow-soft">
        <iframe
          class="h-full min-h-80 w-full"
          src={mapEmbedUrl}
          loading="lazy"
          title={`Mapa — ${venue.name}`}
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>

      <!-- Endereço + dicas + hotéis -->
      <div class="flex flex-col gap-6">
        <article class="reveal rounded-2xl border border-sage-200/70 bg-white p-8 shadow-soft">
          <h3 class="font-display text-2xl text-charcoal">{venue.name}</h3>
          <p class="mt-3 text-sm leading-relaxed text-charcoal/80">📍 {venue.address}</p>
          <a
            href={routeUrl}
            target="_blank"
            rel="noopener"
            class="mt-5 inline-block rounded-full bg-sage-800 px-6 py-2.5 text-sm font-semibold text-ivory transition hover:bg-sage-600"
          >
            🚗 Como chegar
          </a>

          <div class="mt-6 space-y-4 border-t border-sage-100 pt-6 text-sm leading-relaxed text-charcoal/80">
            <p><strong class="text-charcoal">🅿️ Estacionamento:</strong> {venue.parking}</p>
            <p><strong class="text-charcoal">🚌 Transporte:</strong> {venue.transit}</p>
          </div>
        </article>

        <article class="reveal rounded-2xl border border-sage-200/70 bg-white p-8 shadow-soft">
          <h3 class="font-display text-xl text-charcoal">🏨 Onde se hospedar</h3>
          <ul class="mt-4 divide-y divide-sage-100">
            {
              venue.hotels.map((h) => (
                <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 py-3 first:pt-0 last:pb-0">
                  <div>
                    <p class="font-semibold">{h.name}</p>
                    <p class="text-sm text-charcoal/70">{h.note} · {h.distance}</p>
                  </div>
                  {h.url && (
                    <a
                      href={h.url}
                      target="_blank"
                      rel="noopener"
                      class="text-sm font-semibold text-sage-600 underline decoration-gold-500 underline-offset-4 transition hover:text-sage-800"
                    >
                      Ver ↗
                    </a>
                  )}
                </li>
              ))
            }
          </ul>
        </article>
      </div>
    </div>
  </div>
</section>
