---
import SectionTitle from './SectionTitle.astro';
import PixCard from './PixCard.astro';
import { gifts, giftsIntro, type Gift } from '../data/gifts';
---

<section id="presentes" class="bg-ivory py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <SectionTitle eyebrow="Se quiser nos mimar" title="Lista de Presentes" />

    <p class="reveal mx-auto mb-12 max-w-2xl text-center text-charcoal/80">{giftsIntro}</p>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {
        gifts.map((gift: Gift) => (
          <article class="reveal flex flex-col rounded-2xl border border-sage-200/70 bg-white p-6 shadow-soft transition hover:-translate-y-1">
            <div class="grid h-16 w-16 place-items-center rounded-2xl bg-sand text-3xl" aria-hidden="true">
              {gift.icon}
            </div>
            <h3 class="mt-4 font-display text-lg text-charcoal">{gift.name}</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-charcoal/70">{gift.description}</p>
            <p class="mt-4 font-display text-xl text-gold-600">{gift.price}</p>
            <a
              href={gift.url}
              target="_blank"
              rel="noopener"
              class="mt-4 inline-block rounded-full bg-sage-800 px-5 py-2.5 text-center text-sm font-semibold text-ivory transition hover:bg-sage-600"
            >
              Presentear 🎁
            </a>
          </article>
        ))
      }
    </div>

    <div class="reveal mt-10">
      <PixCard />
    </div>
  </div>
</section>
