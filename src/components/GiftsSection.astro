---
import SectionTitle from './SectionTitle.astro';
import PixCard from './PixCard.astro';
import { gifts, giftsIntro, pix, type Gift } from '../data/gifts';
import { site } from '../data/site';
import { pixPayload, pixQrSvg } from '../lib/pix';

const brl = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL', maximumFractionDigits: 0 });

// Pix com o valor exato de cada presente, gerado no build
const giftsWithPix = await Promise.all(
  gifts.map(async (gift: Gift, i) => {
    const payload = pixPayload({
      key: pix.qrKey,
      name: pix.holder,
      city: pix.city,
      amount: gift.price,
      txid: `PRESENTE${i + 1}`,
    });
    const waText = `Oi! Acabei de dar o presente "${gift.name}" (${brl.format(gift.price)}) pelo site 🎁`;
    return {
      ...gift,
      id: `presente-${i + 1}`,
      payload,
      qrSvg: await pixQrSvg(payload),
      waHref: `https://wa.me/${site.rsvp.whatsappNumber}?text=${encodeURIComponent(waText)}`,
    };
  }),
);
---

<section id="presentes" class="bg-ivory py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <SectionTitle eyebrow="Se quiser nos mimar" title="Lista de Presentes" />

    <p class="reveal mx-auto mb-12 max-w-2xl text-center text-charcoal/80">{giftsIntro}</p>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {
        giftsWithPix.map((gift) => (
          <article class="reveal flex flex-col rounded-2xl border border-sage-200/70 bg-white p-6 shadow-soft transition hover:-translate-y-1">
            <div class="grid h-16 w-16 place-items-center rounded-2xl bg-sand text-3xl" aria-hidden="true">
              {gift.icon}
            </div>
            <h3 class="mt-4 font-display text-lg text-charcoal">{gift.name}</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-charcoal/70">{gift.description}</p>
            <p class="mt-4 font-display text-xl text-gold-600">{brl.format(gift.price)}</p>
            <button
              type="button"
              data-gift-open={gift.id}
              class="mt-4 inline-block rounded-full bg-sage-800 px-5 py-2.5 text-center text-sm font-semibold text-ivory transition hover:bg-sage-600"
            >
              Presentear 🎁
            </button>
          </article>
        ))
      }
    </div>

    <div class="reveal mt-10">
      <PixCard />
    </div>
  </div>

  {
    giftsWithPix.map((gift) => (
      <dialog
        id={gift.id}
        aria-labelledby={`${gift.id}-title`}
        class="m-auto w-[calc(100%-2rem)] max-w-md rounded-2xl bg-white p-0 text-charcoal shadow-soft backdrop:bg-charcoal/60"
      >
        <div class="p-6 sm:p-8">
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="text-xs font-bold tracking-widest text-sage-600 uppercase">Presentear</p>
              <h3 id={`${gift.id}-title`} class="mt-1 font-display text-xl">
                {gift.icon} {gift.name}
              </h3>
              <p class="mt-1 font-display text-2xl text-gold-600">{brl.format(gift.price)}</p>
            </div>
            <form method="dialog">
              <button
                class="grid h-9 w-9 place-items-center rounded-full text-xl text-charcoal/60 transition hover:bg-sand hover:text-charcoal"
                aria-label="Fechar"
              >
                ×
              </button>
            </form>
          </div>

          <h4 class="mt-6 text-sm font-bold">Pix</h4>
          <p class="mt-1 text-sm text-charcoal/70">
            Escaneie o QR Code ou copie o código e cole em <strong>Pix copia e cola</strong> no app do seu banco. O valor
            já vem preenchido.
          </p>
          <div
            class="mx-auto mt-4 w-44 rounded-xl border border-sage-200 p-2 [&>svg]:h-auto [&>svg]:w-full"
            role="img"
            aria-label={`QR Code Pix de ${brl.format(gift.price)}`}
            set:html={gift.qrSvg}
          />
          <button
            type="button"
            data-copy={gift.payload}
            class="mt-4 inline-flex w-full items-center justify-center gap-2 rounded-full bg-gold-500 px-6 py-3 text-sm font-bold text-white shadow-soft transition hover:bg-gold-600"
          >
            <span>Copiar Pix copia e cola</span>
          </button>

          {gift.mercadoPagoUrl && (
            <>
              <div class="my-6 flex items-center gap-3 text-xs text-charcoal/50 uppercase">
                <span class="h-px flex-1 bg-sage-200" />
                ou
                <span class="h-px flex-1 bg-sage-200" />
              </div>
              <h4 class="text-sm font-bold">Cartão de crédito</h4>
              <p class="mt-1 text-sm text-charcoal/70">
                Pagamento seguro pelo Mercado Pago, com opção de parcelamento.
              </p>
              <a
                href={gift.mercadoPagoUrl}
                target="_blank"
                rel="noopener"
                class="mt-4 inline-flex w-full items-center justify-center rounded-full bg-sage-800 px-6 py-3 text-sm font-bold text-ivory transition hover:bg-sage-600"
              >
                Pagar com cartão 💳
              </a>
            </>
          )}

          <p class="mt-6 text-center text-xs text-charcoal/60">
            Já presenteou?{' '}
            <a href={gift.waHref} target="_blank" rel="noopener" class="font-bold text-sage-800 underline">
              Avise os noivos pelo WhatsApp
            </a>
          </p>
        </div>
      </dialog>
    ))
  }
</section>

<script>
  // Abre o modal de pagamento do presente; clicar fora do conteúdo fecha
  document.querySelectorAll<HTMLButtonElement>('[data-gift-open]').forEach((btn) => {
    const dialog = document.getElementById(btn.dataset.giftOpen ?? '');
    if (!(dialog instanceof HTMLDialogElement)) return;
    btn.addEventListener('click', () => dialog.showModal());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  });
</script>
