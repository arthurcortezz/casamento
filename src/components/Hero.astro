---
import { site } from '../data/site';

const [firstPerson = '', secondPerson = ''] = site.coupleNames.split(' & ');
---

<section
  id="inicio"
  class="relative flex min-h-svh flex-col items-center justify-center overflow-hidden bg-gradient-to-b from-sage-800 via-sage-700 to-sage-600 px-4 text-center text-ivory"
>
  <!-- Decoração: anéis -->
  <svg class="pointer-events-none absolute -right-20 -top-20 h-96 w-96 opacity-15" viewBox="0 0 200 200" fill="none" aria-hidden="true">
    <circle cx="80" cy="100" r="45" stroke="#d4b96a" stroke-width="2"></circle>
    <circle cx="120" cy="100" r="45" stroke="#fbf8f1" stroke-width="2"></circle>
  </svg>
  <svg class="pointer-events-none absolute -bottom-24 -left-24 h-96 w-96 opacity-10" viewBox="0 0 200 200" fill="none" aria-hidden="true">
    <circle cx="100" cy="100" r="60" stroke="#fbf8f1" stroke-width="1.5"></circle>
    <circle cx="100" cy="100" r="40" stroke="#d4b96a" stroke-width="1.5"></circle>
  </svg>

  <div class="relative pt-24">
    <p class="text-xs font-semibold uppercase tracking-[0.4em] text-gold-400 sm:text-sm">Vamos nos casar</p>
    <h1 class="mt-6 font-display text-5xl leading-tight sm:text-7xl md:text-8xl">
      {firstPerson} <span class="italic text-gold-400">&amp;</span> {secondPerson}
    </h1>
    <p class="mt-6 text-base text-ivory/85 sm:text-lg">
      {site.weddingDateLabel} · às {site.weddingTimeLabel} · {site.city}
    </p>

    <!-- Contagem regressiva -->
    <div id="cd-boxes" class="mx-auto mt-10 grid max-w-md grid-cols-4 gap-2 sm:gap-3">
      <div class="rounded-xl border border-ivory/20 bg-white/10 px-2 py-3 backdrop-blur sm:px-4">
        <span id="cd-d" class="block font-display text-2xl tabular-nums sm:text-4xl">0</span>
        <span class="mt-1 block text-[10px] uppercase tracking-widest text-ivory/70 sm:text-xs">dias</span>
      </div>
      <div class="rounded-xl border border-ivory/20 bg-white/10 px-2 py-3 backdrop-blur sm:px-4">
        <span id="cd-h" class="block font-display text-2xl tabular-nums sm:text-4xl">0</span>
        <span class="mt-1 block text-[10px] uppercase tracking-widest text-ivory/70 sm:text-xs">horas</span>
      </div>
      <div class="rounded-xl border border-ivory/20 bg-white/10 px-2 py-3 backdrop-blur sm:px-4">
        <span id="cd-m" class="block font-display text-2xl tabular-nums sm:text-4xl">0</span>
        <span class="mt-1 block text-[10px] uppercase tracking-widest text-ivory/70 sm:text-xs">min</span>
      </div>
      <div class="rounded-xl border border-ivory/20 bg-white/10 px-2 py-3 backdrop-blur sm:px-4">
        <span id="cd-s" class="block font-display text-2xl tabular-nums sm:text-4xl">0</span>
        <span class="mt-1 block text-[10px] uppercase tracking-widest text-ivory/70 sm:text-xs">seg</span>
      </div>
    </div>
    <p id="cd-done" class="mt-10 hidden font-display text-3xl text-gold-400">🎉 É hoje! Chegou o grande dia! 🎉</p>

    <div class="mt-12 flex flex-col items-center justify-center gap-4 sm:flex-row">
      <a
        href="#rsvp"
        class="w-64 rounded-full bg-gold-500 px-8 py-3.5 font-bold text-white shadow-soft transition hover:bg-gold-600 sm:w-auto"
        >Confirmar presença</a
      >
      <a
        href="#presentes"
        class="w-64 rounded-full border border-ivory/50 px-8 py-3.5 font-semibold text-ivory transition hover:bg-ivory/10 sm:w-auto"
        >Lista de presentes</a
      >
    </div>
  </div>

  <a href="#historia" class="absolute bottom-8 animate-bounce text-ivory/70" aria-label="Rolar para a próxima seção">
    <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
    </svg>
  </a>

  <script define:vars={{ targetISO: site.weddingDateISO }}>
    const target = new Date(targetISO).getTime();
    const elD = document.getElementById('cd-d');
    const elH = document.getElementById('cd-h');
    const elM = document.getElementById('cd-m');
    const elS = document.getElementById('cd-s');
    const pad = (n) => String(n).padStart(2, '0');
    let timer;
    function tick() {
      const diff = target - Date.now();
      if (diff <= 0) {
        document.getElementById('cd-boxes')?.classList.add('hidden');
        document.getElementById('cd-done')?.classList.remove('hidden');
        clearInterval(timer);
        return;
      }
      if (elD) elD.textContent = String(Math.floor(diff / 864e5));
      if (elH) elH.textContent = pad(Math.floor(diff / 36e5) % 24);
      if (elM) elM.textContent = pad(Math.floor(diff / 6e4) % 60);
      if (elS) elS.textContent = pad(Math.floor(diff / 1e3) % 60);
    }
    tick();
    timer = setInterval(tick, 1000);
  </script>
</section>
