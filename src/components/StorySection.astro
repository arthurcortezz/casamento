---
import SectionTitle from './SectionTitle.astro';
import { story } from '../data/info';
---

<section id="historia" class="bg-sand py-20 sm:py-28">
  <div class="mx-auto max-w-4xl px-4 sm:px-6">
    <SectionTitle eyebrow="Nossa trajetória" title="Nossa História" />

    <ol class="relative space-y-10 before:absolute before:left-[19px] before:top-2 before:h-[calc(100%-1rem)] before:w-px before:bg-sage-300 sm:before:left-1/2">
      {
        story.map((item, i) => (
          <li class="relative pl-14 sm:pl-0">
            <span
              class="absolute left-0 top-0 grid h-10 w-10 place-items-center rounded-full border border-gold-500 bg-ivory text-lg shadow-soft sm:left-1/2 sm:-translate-x-1/2"
              aria-hidden="true"
            >
              {item.icon}
            </span>
            <div
              class:list={[
                'reveal rounded-2xl border border-sage-200/70 bg-ivory p-6 shadow-soft sm:w-[calc(50%-2.5rem)] sm:p-8',
                i % 2 === 0 ? 'sm:ml-auto' : 'sm:mr-auto',
              ]}
            >
              <p class="text-sm font-bold tracking-widest text-gold-600">{item.year}</p>
              <h3 class="mt-1 font-display text-xl text-charcoal sm:text-2xl">{item.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-charcoal/80">{item.text}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <p class="reveal mt-14 text-center font-display text-xl text-sage-700 sm:text-2xl">
      ... e agora, o próximo capítulo é com vocês! 💛
    </p>
  </div>
</section>
