---
import { pix } from '../data/gifts';
---

<article
  class="mx-auto max-w-3xl rounded-2xl border-2 border-dashed border-gold-500/60 bg-sand p-8 sm:p-10"
>
  <div class="grid items-center gap-8 sm:grid-cols-[auto_1fr]">
    <div class="mx-auto w-48 rounded-xl border border-sage-200 bg-white p-2 shadow-soft">
      <img src={pix.qrImage} alt={`QR Code Pix dos noivos — chave: ${pix.key}`} width="180" height="180" loading="lazy" class="h-auto w-full" />
    </div>

    <div class="text-center sm:text-left">
      <h3 class="font-display text-2xl text-charcoal">Prefere presentear com Pix? 💛</h3>
      <p class="mt-2 text-sm leading-relaxed text-charcoal/70">
        Escaneie o QR Code ou use a chave abaixo. Valor livre — o carinho é o que conta!
      </p>

      <dl class="mt-5 space-y-1.5 text-sm text-charcoal/80">
        <div class="flex flex-wrap justify-center gap-x-2 sm:justify-start">
          <dt class="font-bold">Chave ({pix.keyType}):</dt>
          <dd class="break-all">{pix.key}</dd>
        </div>
        <div class="flex flex-wrap justify-center gap-x-2 sm:justify-start">
          <dt class="font-bold">Favorecido:</dt>
          <dd>{pix.holder}</dd>
        </div>
        <div class="flex flex-wrap justify-center gap-x-2 sm:justify-start">
          <dt class="font-bold">Banco:</dt>
          <dd>{pix.bank} · {pix.city}</dd>
        </div>
      </dl>

      <button
        type="button"
        data-copy={pix.key}
        class="mt-6 inline-flex items-center gap-2 rounded-full bg-gold-500 px-6 py-3 text-sm font-bold text-white shadow-soft transition hover:bg-gold-600"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 8V5a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-3m-11-3a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2v-7Z"></path>
        </svg>
        <span>Copiar chave Pix</span>
      </button>
    </div>
  </div>
</article>

<script>
  // Botão "copiar" da chave Pix
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.dataset.copy ?? '';
      let ok = false;
      try {
        await navigator.clipboard.writeText(text);
        ok = true;
      } catch {
        // Fallback para navegadores antigos / contextos não seguros
        const tmp = document.createElement('textarea');
        tmp.value = text;
        document.body.appendChild(tmp);
        tmp.select();
        ok = document.execCommand('copy');
        tmp.remove();
      }
      const label = btn.querySelector('span:last-child');
      if (label) {
        const original = label.textContent ?? '';
        label.textContent = ok ? 'Copiado! ✓' : 'Não foi possível copiar';
        btn.disabled = true;
        setTimeout(() => {
          label.textContent = original;
          btn.disabled = false;
        }, 2500);
      }
    });
  });
</script>
