---
import SectionTitle from './SectionTitle.astro';
import { faq } from '../data/info';
---

<section id="faq" class="bg-ivory py-20 sm:py-28">
  <div class="mx-auto max-w-3xl px-4 sm:px-6">
    <SectionTitle eyebrow="Dúvidas comuns" title="Perguntas Frequentes" />

    <div class="reveal space-y-3">
      {
        faq.map((item) => (
          <details class="group rounded-2xl border border-sage-200/70 bg-white shadow-soft">
            <summary class="flex items-center justify-between gap-4 px-6 py-5 font-semibold text-charcoal transition hover:text-sage-600">
              {item.q}
              <svg
                class="faq-chevron h-5 w-5 shrink-0 text-sage-600"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6" />
              </svg>
            </summary>
            <p class="px-6 pb-6 text-sm leading-relaxed text-charcoal/80">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
