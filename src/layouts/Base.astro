---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${site.coupleNames} — Casamento · ${site.weddingDateLabel}`,
  description = `Site oficial do casamento de ${site.coupleNames}: ${site.weddingDateLabel}, em ${site.city}. Confirme sua presença, veja o local e a lista de presentes.`,
} = Astro.props;

const navLinks = [
  { href: '#historia', label: 'Nossa História' },
  { href: '#informacoes', label: 'Informações' },
  { href: '#local', label: 'Local' },
  { href: '#presentes', label: 'Presentes' },
  { href: '#rsvp', label: 'Confirmação' },
  { href: '#faq', label: 'FAQ' },
];

const ogImage = Astro.site
  ? new URL('/images/og-cover.svg', Astro.site).toString()
  : '/images/og-cover.svg';
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : Astro.url.pathname;
const waHref = `https://wa.me/${site.rsvp.whatsappNumber}?text=${encodeURIComponent(site.rsvp.whatsappMessage)}`;
const nameParts = site.coupleNames.split(' & ');
const monogramInitials = nameParts.map((p) => p.trim().charAt(0).toUpperCase());
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#46513b" />
    <link rel="canonical" href={canonical} />

    <!-- Compartilhamento no WhatsApp/redes sociais -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.coupleNames} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="pt_BR" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Fontes -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lato:wght@300;400;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-ivory font-body text-charcoal antialiased">
    <a href="#conteudo" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:bg-white focus:p-3"
      >Pular para o conteúdo</a
    >

    <header class="fixed inset-x-0 top-0 z-40 border-b border-sage-200/60 bg-ivory/85 backdrop-blur">
      <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:h-20 sm:px-6">
        <a href="#inicio" class="flex items-center gap-3" aria-label={site.coupleNames}>
          <span
            class="grid h-10 w-10 place-items-center rounded-full border border-gold-500 bg-sage-800 font-display text-sm text-ivory"
          >
            {monogramInitials[0]}<span class="text-gold-400">&amp;</span>{monogramInitials[1]}
          </span>
          <span class="hidden font-display text-lg sm:block">{site.coupleNames}</span>
        </a>

        <nav class="hidden items-center gap-6 text-sm md:flex" aria-label="Principal">
          {navLinks.map((l) => <a class="transition hover:text-sage-600" href={l.href}>{l.label}</a>)}
          <a
            href="#rsvp"
            class="rounded-full bg-sage-800 px-4 py-2 font-semibold text-ivory transition hover:bg-sage-600"
            >Confirmar presença</a
          >
        </nav>

        <button
          id="menu-btn"
          type="button"
          class="grid h-10 w-10 place-items-center rounded-lg border border-sage-200 md:hidden"
          aria-expanded="false"
          aria-controls="menu-panel"
          aria-label="Abrir menu"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </button>
      </div>

      <nav id="menu-panel" class="hidden border-t border-sage-200/60 bg-ivory px-4 pb-4 pt-2 md:hidden" aria-label="Menu móvel">
        {navLinks.map((l) => (
          <a class="block rounded-lg px-3 py-3 text-sm transition hover:bg-sand" href={l.href}>{l.label}</a>
        ))}
        <a href="#rsvp" class="mt-2 block rounded-full bg-sage-800 px-4 py-3 text-center font-semibold text-ivory">
          Confirmar presença
        </a>
      </nav>
    </header>

    <main id="conteudo">
      <slot />
    </main>

    <Footer />

    <!-- Botão flutuante do WhatsApp -->
    <a
      href={waHref}
      target="_blank"
      rel="noopener"
      aria-label="Falar com os noivos no WhatsApp"
      class="fixed bottom-5 right-5 z-40 grid h-14 w-14 place-items-center rounded-full bg-[#25D366] text-white shadow-soft transition hover:scale-105"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.87 9.87 0 0 0 4.79 1.22h.01c5.46 0 9.9-4.45 9.9-9.91A9.86 9.86 0 0 0 12.04 2Zm5.8 14.03c-.24.68-1.4 1.3-1.93 1.35-.53.05-1.02.14-2.9-.6-2.28-.9-3.72-3.25-3.84-3.4-.12-.16-.92-1.23-.92-2.34 0-1.11.58-1.66.79-1.89.2-.22.44-.28.6-.28.17 0 .33 0 .48.01.16.01.37-.06.58.44.2.5.7 1.73.76 1.85.06.12.1.26.02.42-.08.16-.12.26-.24.4-.12.15-.25.32-.36.43-.12.12-.25.25-.11.49.14.24.62 1.03 1.34 1.66.92.82 1.7 1.07 1.94 1.19.24.12.38.1.52-.06.14-.16.6-.7.76-.94.16-.24.32-.2.54-.12.22.08 1.39.66 1.63.78.24.12.4.18.46.28.06.1.06.58-.18 1.26Z"
        ></path>
      </svg>
    </a>

    <script>
      // Menu móvel
      const menuBtn = document.getElementById('menu-btn');
      const menuPanel = document.getElementById('menu-panel');
      menuBtn?.addEventListener('click', () => {
        const isOpen = menuPanel?.classList.toggle('hidden') === false;
        menuBtn?.setAttribute('aria-expanded', String(isOpen));
      });
      menuPanel?.querySelectorAll('a').forEach((a) =>
        a.addEventListener('click', () => {
          menuPanel.classList.add('hidden');
          menuBtn?.setAttribute('aria-expanded', 'false');
        }),
      );

      // Revelar elementos ao rolar a página
      const revealEls = document.querySelectorAll('.reveal');
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.12 },
      );
      revealEls.forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
